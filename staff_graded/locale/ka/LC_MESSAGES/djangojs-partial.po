#: staff_graded/static/js/src/staff_graded.js:10
msgid "{error_count} error. Please try again. "
msgid_plural "{error_count} errors. Please try again. "
msgstr[0] "{error_count} შეცდომა. გთხოვთ, სცადოთ ხელახლა. "

#: staff_graded/static/js/src/staff_graded.js:21
msgid "Processed {row_count} row. "
msgid_plural "Processed {row_count} rows. "
msgstr[0] "დამუშავდა {row_count} სტრიქონი. "

#: staff_graded/static/js/src/staff_graded.js:25
msgid "Updated scores for {row_count} learner."
msgid_plural "Updated scores for {row_count} learners."
msgstr[0] "ქულები განახლდა {row_count} სტუდენტისთვის."

#: staff_graded/static/js/src/staff_graded.js:61
msgid ""
"Files must be less than 4MB. Please split the file into smaller chunks and "
"upload again."
msgstr ""
"ფაილები უნდა იყოს 4 მბ-ზე ნაკლები. გთხოვთ, დაყოთ ფაილი პატარა ნაწილებად და "
"კვლავ ატვირთოთ."
