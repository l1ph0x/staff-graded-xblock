#: staff_graded/staff_graded.py:53
msgid "Display Name"
msgstr "ხილული სახელი"

#: staff_graded/staff_graded.py:54
msgid "The display name for this component."
msgstr "ამ კომპონენტის ხილული სახელი."

#: staff_graded/staff_graded.py:56
msgid "Staff Graded Points"
msgstr "პერსონალის შეფასების ქულები"

#: staff_graded/staff_graded.py:59
msgid "Instructions"
msgstr "ინსტრუქციები"

#: staff_graded/staff_graded.py:60
msgid "The instructions to the learner. Markdown format"
msgstr "ინსტრუქცია სტუდენტებისთვის. Markdown ფორმატი"

#: staff_graded/staff_graded.py:63
msgid "Your results will be graded offline"
msgstr "თქვენი შედეგები შეფასდება ოფლაინ რეჟიმში"

#: staff_graded/staff_graded.py:69
msgid ""
"Enter the number of points possible for this component.  The default value "
"is 1.0.  "
msgstr ""
"შეიყვანეთ ამ კომპონენტისთვის შესაძლებელი ქულების რაოდენობა.  ნაგულისხმევი "
"მნიშვნელობა არის 1.0.  "

#: staff_graded/staff_graded.py:140
#, python-brace-format
msgid "{score} / {total} points"
msgstr "{score} / {total} ქულა"

#: staff_graded/staff_graded.py:142
#, python-brace-format
msgid "{total} points possible"
msgstr "შესაძლებელია {total} ქულა"

#: staff_graded/staff_graded.py:190
msgid "Dummy"
msgstr "ფიქტიური"

#: staff_graded/staff_graded.py:205
msgid "missing file"
msgstr "ფაილი აკლია"

#: staff_graded/static/html/staff_graded.html:17
msgid "Step 1:"
msgstr "ნაბიჯი 1:"

#: staff_graded/static/html/staff_graded.html:17
msgid "Export scores."
msgstr "ქულების ექსპორტირება."

#: staff_graded/static/html/staff_graded.html:18
msgid ""
"Download a grading CSV and use this as a template to assign scores for this "
"problem."
msgstr ""
"ჩამოტვირთეთ შეფასების ფაილი CSV ფორმატში და გამოიყენეთ იგი შაბლონის სახით "
"ამ დავალებაში ქულების მინიჭებისთვის."

#: staff_graded/static/html/staff_graded.html:20
msgid "Choose a track and/or cohort:"
msgstr "აირჩიეთ ჩარიცხვის რეჟიმი, track და/ან კოჰორტა:"

#: staff_graded/static/html/staff_graded.html:21
msgid "Enrollment Track"
msgstr "ჩარიცხვის რეჟიმი, track"

#: staff_graded/static/html/staff_graded.html:22
msgid "(All Tracks)"
msgstr "(ყველა რეჟიმი, tracks)"

#: staff_graded/static/html/staff_graded.html:27
msgid "Cohort"
msgstr "კოჰორტა"

#: staff_graded/static/html/staff_graded.html:28
msgid "(All Cohorts)"
msgstr "(ყველა კოჰორტა)"

#: staff_graded/static/html/staff_graded.html:34
msgid "export scores"
msgstr "ქულების ექსპორტირება"

#: staff_graded/static/html/staff_graded.html:36
msgid "Step 2:"
msgstr "ნაბიჯი 2:"

#: staff_graded/static/html/staff_graded.html:36
msgid "(On your own machine) Fill out grades."
msgstr "(საკუთარ მოწყობილობაზე) შეავსეთ შეფასებების ნიშნები."

#: staff_graded/static/html/staff_graded.html:37
msgid ""
"Open the CSV in a spreadsheet editor and assign scores to learners via “New "
"Points” field. Leave scores that you don’t want to change blank."
msgstr ""
"გახსენით CSV ფაილი ელ-ცხრილების რედაქტორში, მაგ., MS Excel -ით და "
"სტუდენტებს მიანიჭეთ ქულები ველის \"ახალი ქულები\" მეშვეობით. დატოვეთ "
"ქულები, რომელთა შეცვლაც არ გსურთ."

#: staff_graded/static/html/staff_graded.html:39
msgid "Step 3:"
msgstr "ნაბიჯი 3:"

#: staff_graded/static/html/staff_graded.html:39
msgid "Import scores."
msgstr "ქულების იმპორტი."

#: staff_graded/static/html/staff_graded.html:40
msgid ""
"Upload the filled out CSV. Learners will immediately see their grades after "
"import completes."
msgstr ""
"ატვირთეთ შევსებული CSV ფაილი. ატვირთვის დასრულების შემდეგ მოსწავლეები "
"დაუყოვნებლივ იხილავენ თავიანთ შეფასებებს."

#: staff_graded/static/html/staff_graded.html:41
msgid "Note: Supports file sizes up to 4MB."
msgstr "შენიშვნა: მხარდაჭერილი ფაილის მაქვს. ზომა 4 მბ -მდე."
